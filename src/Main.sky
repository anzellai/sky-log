module Main exposing (main)

import Sky.Core.Prelude exposing (..)
import Sky.Core.System as System
import Sky.Core.Process as Process
import Sky.Core.Result as Result
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.File as File
import Sky.Core.Dict as Dict
import Sky.Core.Task as Task
import Sky.Core.Io as Io
import Sky.Core.Maybe as Maybe
import Sky.Core.Tuple as Tuple
import Std.Log exposing (println)
import Std.Html exposing (..)
import Std.Html.Attributes exposing (..)
import Std.Css exposing (..)
import Std.Css as Css
import Std.App as App
import Std.Html.Events exposing (onClick, onInput, onChange)
import Std.Cmd as Cmd
import Std.Sub as Sub
import Std.Time as Time
import Log.Entry as Entry exposing (..)
import Log.Config as Config
import Log.Webhook as Webhook exposing (WebhookRule)


-- Per CLAUDE.md Limitation #11, `exposing (Constructor)` on its own
-- doesn't import ADT constructors from user modules (only kernel
-- modules). Workaround: import via `exposing (..)` so all symbols
-- (constructors + aliases + functions) come into scope. The `as Entry`
-- alias remains usable for the qualified-call sites
-- (Entry.decodeEntry, Entry.levelToInt, etc.).
-- Per CLAUDE.md Limitation #15, `import X as Alias` leaks the alias
-- into codegen for exposed record/ADT types — `Webhook.WebhookRule`
-- emits as `Webhook_WebhookRule_R` instead of `Log_Webhook_WebhookRule_R`,
-- breaking cross-module resolution. Workaround: import the type by
-- name (no alias prefix at use sites) AND keep the function alias.
helpText : String
helpText =
    "sky-log — real-time log viewer\n\nUsage:\n  sky-log [options] [file ...]\n  command | sky-log\n\nOptions:\n  -h, --help    Show this help message\n\nExamples:\n  sky-log app.log                  Watch a log file\n  sky-log app.log server.log       Watch multiple files\n  tail -f /var/log/syslog | sky-log  Pipe stdin\n  sky-log                          Use sources from sky-log.toml\n"

type Page
    = LogPage

type alias SourceScanner =
    { proc : Maybe Process.Process
    , offset : Int
    , partial : String
    , label : String
    }

type alias WatchedFile =
    { path : String
    , label : String
    }

type SourceMode
    = FileMode
    | StreamMode

type alias FileCollect =
    { entries : List LogEntry
    , counts : Dict.Dict String Int
    , newEntries : List LogEntry
    }

type alias Resolved =
    { watched : List WatchedFile
    , scanners : List SourceScanner
    , mode : SourceMode
    }

type alias Model =
    { entries : List LogEntry
    , levelFilter : String
    , scopeFilter : String
    , searchFilter : String
    , sourceFilter : String
    , autoScroll : Bool
    , theme : String
    , watched : List WatchedFile
    , scanners : List SourceScanner
    , fileCounts : Dict.Dict String Int
    , sourceMode : SourceMode
    , webhookRules : List WebhookRule
    }

type Msg
    = Tick
    | SetLevelFilter String
    | SetScopeFilter String
    | SetSearchFilter String
    | SetSourceFilter String
    | ToggleAutoScroll
    | ToggleTheme
    | ClearLogs
    | Navigate Page


readFileEntries : WatchedFile -> List LogEntry
readFileEntries source =
    -- File.readFile returns Task Error String per the effect-boundary
    -- audit. We force eagerly with Task.run because the caller is
    -- inside a synchronous polling loop — matches pre-migration
    -- semantics. For long-running reads, factor into a top-level
    -- Task and dispatch via Cmd.perform.
    case Task.run (File.readFile source.path) of

        Ok content ->
            content |> String.lines
                |> List.filter (\l -> not (String.isEmpty l))
                |> List.map (\l -> Entry.decodeEntry l source.label)

        Err _ ->
            []


collectFileEntries : List WatchedFile -> Dict.Dict String Int -> List LogEntry -> FileCollect
collectFileEntries watched counts existing =
    List.foldl
        (\source acc ->
            let
                seen =
                    case Dict.get source.path acc.counts of

                        Just n ->
                            n

                        Nothing ->
                            0
                allEntries = readFileEntries source
                total = List.length allEntries
                newOnes = List.drop seen allEntries
            in
                { entries = List.append acc.entries newOnes
                , counts = Dict.insert source.path total acc.counts
                , newEntries = List.append acc.newEntries newOnes
                })
        { entries = existing, counts = counts, newEntries = [] }
        watched


scanLine : SourceScanner -> ( SourceScanner, List LogEntry )
scanLine source =
    case source.proc of

        Just proc ->
            case Task.run
                     (Process.readWithin 20 proc Process.Stdout source.offset) of

                Ok chunk ->
                    let
                        parts =
                            String.split "\n" (source.partial ++ chunk.data)
                        complete = List.take (List.length parts - 1) parts
                        rest =
                            List.drop (List.length parts - 1) parts |> List.head
                                |> Maybe.withDefault ""
                    in
                        ( { source | offset = chunk.next, partial = rest }
                        , List.map
                              (\l -> Entry.decodeEntry l source.label)
                              complete
                        )

                Err _ ->
                    ( source, [] )

        Nothing ->
            case Task.run (Io.readLine ()) of

                Ok text ->
                    ( source, [ Entry.decodeEntry text source.label ] )

                Err _ ->
                    ( source, [] )


collectStreamEntries : List SourceScanner -> ( List SourceScanner, List LogEntry )
collectStreamEntries scanners =
    let
        polled = List.map scanLine scanners
    in
        ( List.map Tuple.first polled, List.concatMap Tuple.second polled )


initStdinScanner =
    Just { proc = Nothing, offset = 0, partial = "", label = "stdin" }


initCommandScanner : Config.Source -> Maybe SourceScanner
initCommandScanner source =
    case Task.run
             (Process.spawn
                 (Process.command "sh"
                     |> Process.withArgs [ "-c", source.command ])) of

        Ok proc ->
            Just
                { proc = Just proc
                , offset = 0
                , partial = ""
                , label = source.name
                }

        Err _ ->
            Nothing


resolveMode : List String -> List Config.Source -> Resolved
resolveMode args sources =
    if not (List.isEmpty args) then
        { watched = List.map (\f -> { path = f, label = f }) args
        , scanners = []
        , mode = FileMode
        }

    else
        let
            cmdScanners = List.filterMap initCommandScanner sources
        in
            if not (List.isEmpty cmdScanners) then
                { watched = [], scanners = cmdScanners, mode = StreamMode }

            else
                { watched = []
                , scanners = List.filterMap identity [ initStdinScanner ]
                , mode = StreamMode
                }


-- Sky.Live runtime passes a request-context map (map[string]any with
-- `"path": …` etc.). Other examples annotate this slot as `a` so HM
-- doesn't narrow the param to whatever concrete shape the framework
-- happens to send. Narrowing it to `Page` here panicked at GET /
-- with `reflect: Call using map[string]interface {} as type int`.
init : a -> ( Model, Cmd.Cmd Msg )
init _ =
    let
        -- System.args excludes the program name and returns a Task. At
        -- startup collapse it to a bare list, empty if the call fails.
        rawArgs = System.args () |> Task.run |> Result.withDefault []
        _ =
            if List.any (\a -> a == "--help" || a == "-h") rawArgs then
                let
                    _ = println helpText
                in
                    System.exit 0

            else
                ()
        args = List.filter (\a -> not (String.startsWith "-" a)) rawArgs
        config = Config.parseConfig "sky-log.toml"
        resolved = resolveMode args config.sources
        webhookRules = Webhook.buildRules config
        result = collectFileEntries resolved.watched Dict.empty []
    in
        ( { entries = result.entries
          , levelFilter = ""
          , scopeFilter = ""
          , searchFilter = ""
          , sourceFilter = ""
          , autoScroll = True
          , theme = "dark"
          , watched = resolved.watched
          , scanners = resolved.scanners
          , fileCounts = result.counts
          , sourceMode = resolved.mode
          , webhookRules = webhookRules
          }
        , Cmd.none
        )


update : Msg -> Model -> ( Model, Cmd.Cmd Msg )
update msg model =
    case msg of

        Tick ->
            case model.sourceMode of

                FileMode ->
                    let
                        result =
                            collectFileEntries
                                model.watched
                                model.fileCounts
                                model.entries
                        _ =
                            Webhook.processNewEntries
                                model.webhookRules
                                result.newEntries
                    in
                        ( { model
                              | entries = result.entries
                              , fileCounts = result.counts
                          }
                        , Cmd.none
                        )

                StreamMode ->
                    let
                        polled = collectStreamEntries model.scanners
                        newEntries = Tuple.second polled
                        _ =
                            Webhook.processNewEntries
                                model.webhookRules
                                newEntries
                    in
                        ( { model
                              | entries = List.append model.entries newEntries
                              , scanners = Tuple.first polled
                          }
                        , Cmd.none
                        )

        SetLevelFilter value ->
            ( { model | levelFilter = value }, Cmd.none )

        SetScopeFilter value ->
            ( { model | scopeFilter = value }, Cmd.none )

        SetSearchFilter value ->
            ( { model | searchFilter = value }, Cmd.none )

        SetSourceFilter value ->
            ( { model | sourceFilter = value }, Cmd.none )

        ToggleAutoScroll ->
            ( { model | autoScroll = not model.autoScroll }, Cmd.none )

        ToggleTheme ->
            let
                newTheme =
                    if model.theme == "dark" then
                        "light"

                    else
                        "dark"
            in
                ( { model | theme = newTheme }, Cmd.none )

        ClearLogs ->
            ( { model | entries = [] }, Cmd.none )

        Navigate _ ->
            ( model, Cmd.none )


subscriptions : Model -> Sub.Sub Msg
subscriptions _ =
    Time.every 200 Tick


filterEntry : String -> String -> String -> String -> LogEntry -> Bool
filterEntry levelStr scopeStr searchStr sourceStr entry =
    let
        levelOk =
            if String.isEmpty levelStr then
                True

            else
                Entry.levelToInt entry.level
                    >= Entry.levelToInt (Entry.levelFromString levelStr)
        scopeOk =
            if String.isEmpty scopeStr then
                True

            else
                String.contains
                    (String.toLower scopeStr)
                    (String.toLower entry.scope)
        searchOk =
            if String.isEmpty searchStr then
                True

            else
                Entry.matchesPattern searchStr entry.message
        sourceOk =
            if String.isEmpty sourceStr then
                True

            else
                entry.source == sourceStr
    in
        levelOk && scopeOk && searchOk && sourceOk


levelClass : Level -> String
levelClass level =
    case level of

        Debug ->
            "log-entry l-debug"

        Info ->
            "log-entry l-info"

        Warn ->
            "log-entry l-warn"

        ErrorLevel ->
            "log-entry l-error"


padRight : Int -> String -> String -> String
padRight targetLen pad str =
    if String.length str >= targetLen then
        str

    else
        padRight targetLen pad (str ++ pad)


formatTimestamp : Int -> String
formatTimestamp ts =
    let
        secs =
            if ts > 9999999999 then
                ts // 1000

            else
                ts
        totalSeconds = secs - ((secs // 86400) * 86400)
        h = totalSeconds // 3600
        remainder = totalSeconds - (h * 3600)
        m = remainder // 60
        s = remainder - (m * 60)
    in
        padZero h ++ ":" ++ padZero m ++ ":" ++ padZero s


padZero : Int -> String
padZero n =
    if n < 10 then
        "0" ++ String.fromInt n

    else
        String.fromInt n


viewEntry : LogEntry -> Html Msg
viewEntry entry =
    div
        [ class (levelClass entry.level) ]
        [ span [ class "ts" ] [ text (formatTimestamp entry.timestamp) ]
        , span
              [ class "level" ]
              [ text
                    (String.toUpper
                        (padRight 5 " " (Entry.levelToString entry.level)))
              ]
        , span [ class "source" ] [ text entry.source ]
        , span [ class "scope" ] [ text entry.scope ]
        , span [ class "msg" ] [ text entry.message ]
        ]


viewEntries : List LogEntry -> Html Msg
viewEntries entries =
    if List.isEmpty entries then
        div [ class "empty" ] [ text "Waiting for logs..." ]

    else
        div [ id "log-entries" ] (List.map viewEntry (List.take 5000 entries))


statusText : Model -> String
statusText model =
    case model.sourceMode of

        FileMode ->
            let
                labels = List.map (\w -> w.label) model.watched
            in
                "Watching " ++ String.fromInt (List.length model.watched)
                    ++ " source(s): "
                    ++ String.join ", " labels

        StreamMode ->
            let
                labels = List.map (\s -> s.label) model.scanners
            in
                "Streaming: " ++ String.join ", " labels


