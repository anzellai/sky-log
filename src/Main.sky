                  ]
            ])


uniqueSources : List LogEntry -> List String
uniqueSources entries =
    entries |> List.map (\e -> e.source)
        |> List.filter (\s -> not (String.isEmpty s))
        |> List.foldl
               (\s acc ->
                   if List.member s acc then
                       acc

                   else
                       List.append acc [ s ])
               []


view : Model -> Html Msg
view model =
    let
        filtered =
            model.entries
                |> List.filter
                       (filterEntry
                           model.levelFilter
                           model.scopeFilter
                           model.searchFilter
                           model.sourceFilter)
        sources = uniqueSources model.entries
        totalCount = List.length model.entries
        filteredCount = List.length filtered
        scrollLabel =
            if model.autoScroll then
                "Auto-scroll"

            else
                "Paused"
        scrollClass =
            if model.autoScroll then
                "btn active"

            else
                "btn"
        themeIcon =
            if model.theme == "dark" then
                "☼"

            else
                "☾"
    in
        div
            [ class ("root " ++ model.theme) ]
            [ pageStyles
            , div
                  [ class "toolbar" ]
                  [ h1 [] [ text "sky", span [] [ text "-log" ] ]
                  , button
                        [ class "btn", onClick ToggleTheme ]
                        [ text themeIcon ]
                  , select
                        [ id "level-filter", onChange SetLevelFilter ]
                        [ option [ value "" ] [ text "Level" ]
                        , option [ value "debug" ] [ text "DEBUG" ]
                        , option [ value "info" ] [ text "INFO" ]
                        , option [ value "warn" ] [ text "WARN" ]
                        , option [ value "error" ] [ text "ERROR" ]
                        ]
                  , input
                        [ id "scope-filter"
                        , type_ "text"
                        , placeholder "scope"
                        , onInput SetScopeFilter
                        ]
                  , input
                        [ id "search-filter"
                        , type_ "text"
                        , placeholder "regex search"
                        , onInput SetSearchFilter
                        ]
                  , select
                        [ id "source-filter", onChange SetSourceFilter ]
                        (List.append
                            [ option [ value "" ] [ text "Source" ] ]
                            (List.map
                                (\s -> option [ value s ] [ text s ])
                                sources))
                  , div [ class "spacer" ] []
                  , button
                        [ class scrollClass, onClick ToggleAutoScroll ]
                        [ text scrollLabel ]
                  , button
                        [ class "btn danger", onClick ClearLogs ]
                        [ text "Clear" ]
                  ]
            , viewEntries filtered
            , div
                  [ class "status" ]
                  [ span [ class "dot" ] []
                  , text (statusText model)
                  , div [ class "spacer" ] []
                  , span
                        [ class "stats" ]
                        [ text
                              (String.fromInt filteredCount ++ "/"
                                  ++ String.fromInt totalCount)
                        ]
                  ]
            ]


appDef =
    App.web
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes [ App.route "/" LogPage ]
        |> App.withNotFound LogPage
        |> App.withConfig (App.WebConfig { App.webDefaults | port = 4000 })


main =
    App.run appDef
