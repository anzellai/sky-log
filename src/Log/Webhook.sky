module Log.Webhook exposing (..)

import Sky.Core.Prelude exposing (..)
import Sky.Core.Result as Result
import Sky.Core.String as String
import Sky.Core.List as List
import Sky.Core.Json.Encode as Encode
import Sky.Core.Io as Io
import Sky.Core.Process as Process
import Sky.Core.Task as Task
import Std.Cmd as Cmd
import Log.Entry exposing (LogEntry, levelToString, matchesPattern)
import Log.Config as Config

type alias WebhookRule =
    { filter : String
    , url : String
    , sourceName : String
    }


buildRules : Config.AppConfig -> List WebhookRule
buildRules config =
    List.filterMap
        (\source ->
            let
                filter =
                    if String.isEmpty source.filter then
                        config.webhook.filter

                    else
                        source.filter
                url =
                    if String.isEmpty source.webhookUrl then
                        config.webhook.url

                    else
                        source.webhookUrl
            in
                if String.isEmpty filter || String.isEmpty url then
                    Nothing

                else
                    Just
                        { filter = filter, url = url, sourceName = source.name })
        config.sources


matchesFilter : String -> LogEntry -> Bool
matchesFilter pattern entry =
    if String.isEmpty pattern then
        False

    else
        matchesPattern pattern entry.message


buildPayload : LogEntry -> String
buildPayload entry =
    Encode.encode
        0
        (Encode.object
            [ ( "source", Encode.string entry.source )
            , ( "level", Encode.string (levelToString entry.level) )
            , ( "scope", Encode.string entry.scope )
            , ( "message", Encode.string entry.message )
            , ( "timestamp", Encode.int entry.timestamp )
            ])


-- A webhook is best effort: a failed log write or POST never stops the app.
bestEffort : Task Error () -> Task Error ()
bestEffort task =
    task |> Task.onError (\_ -> Task.succeed ())


logTask : String -> Task Error ()
logTask msg =
    bestEffort (Io.writeStderr (msg ++ "\n"))


sendTask : String -> LogEntry -> Task Error ()
sendTask url entry =
    Process.run
        "curl"
        [ "-s"
        , "-X"
        , "POST"
        , "-H"
        , "Content-Type: application/json"
        , "-d"
        , buildPayload entry
        , url
        ]
        |> Task.map (\_ -> ())
        |> bestEffort


fireTask : WebhookRule -> LogEntry -> Task Error ()
fireTask rule entry =
    Task.sequence
        [ logTask
              ("[webhook] filter matched: source=" ++ entry.source ++ " filter="
                  ++ rule.filter
                  ++ " message="
                  ++ entry.message)
        , sendTask rule.url entry
        , logTask ("[webhook] fired: url=" ++ rule.url)
        ]
        |> Task.map (\_ -> ())


entryTasks : List WebhookRule -> LogEntry -> List (Task Error ())
entryTasks rules entry =
    rules
        |> List.filter
               (\rule ->
                   rule.sourceName == entry.source
                       && matchesFilter rule.filter entry)
        |> List.map (\rule -> fireTask rule entry)


-- `notify done rules entries` fires every matching webhook as one background
-- Task. `done` is the Msg sent when they have all finished.
notify : msg -> List WebhookRule -> List LogEntry -> Cmd.Cmd msg
notify done rules entries =
    if List.isEmpty rules || List.isEmpty entries then
        Cmd.none

    else
        Cmd.perform
            (Task.sequence (List.concatMap (entryTasks rules) entries)
                |> Task.map (\_ -> ()))
            (\_ -> done)
